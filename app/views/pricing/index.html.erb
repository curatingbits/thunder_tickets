<% content_for :title, "Pricing · MADR TICKETS" %>

<div class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3">
    <div>
      <h1 class="text-3xl sm:text-4xl font-bold text-content-strong">Pricing</h1>
      <p class="text-content-dim mt-2">Market value and recommended list prices for <%= @season.year %>. Prices are per ticket.</p>
    </div>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
      <%= link_to "3D seat map →", seat_map_path, class: "text-accent hover:brightness-125" %>
      <%= link_to "Insights →", insights_path, class: "text-accent hover:brightness-125" %>
      <% if (run = @board.last_run) %>
        <%= link_to import_runs_path, class: "text-accent hover:brightness-125" do %>
          Last research: <%= run.status %>, <%= time_ago_in_words(run.started_at) %> ago →
        <% end %>
      <% else %>
        <%= link_to "Research runs →", import_runs_path, class: "text-accent hover:brightness-125" %>
      <% end %>
    </div>
  </div>

  <%= render "pricing/value_tiles", value: @value, counts: @counts %>

  <%# Opens on Unsold; "All" adds the games already sold or transferred. %>
  <div class="flex flex-wrap gap-2">
    <% [ [ "Unsold", "unsold" ], [ "Needs action", "action" ], [ "Overpriced", "overpriced" ], [ "Underpriced", "underpriced" ],
         [ "Not listed", "not_listed" ], [ "Verify listing", "verify" ], [ "All", "all" ] ].each do |label, filter| %>
      <% current = @filter == filter %>
      <%= link_to label, pricing_path(filter: (filter unless filter == PricingController::DEFAULT_FILTER)),
            aria: { current: ("page" if current) }, data: { pricing_filter: filter },
            class: "px-3 py-1.5 rounded-lg text-sm #{current ? "bg-accent text-canvas font-semibold" : "bg-surface-raised text-content hover:bg-strong"}" %>
    <% end %>
  </div>

  <% if @rows.empty? %>
    <div class="card text-center py-12">
      <p class="text-content-dim text-lg"><%= @filter == "unsold" ? "No unsold games to price." : "No games match." %></p>
    </div>
  <% else %>
    <%= render "pricing/board", rows: @rows %>
  <% end %>

  <p class="text-xs text-muted">
    All-in prices are what buyers see on Ticketmaster (fees in, tax out). List prices are what you enter when listing.
    Comparables are rows near DD in sections 101, 102 and 120; section 119 is read for context only.
  </p>
</div>
