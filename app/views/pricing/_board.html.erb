<%# The pricing board's games: a table on desktop, cards on phones. Pricing
    lists them all; Home shows the next three unsold. %>
<%# Desktop table %>
<div class="card hidden lg:block p-0 overflow-x-auto">
  <table class="data-table">
    <thead>
      <tr>
        <th scope="col">Game</th>
        <th scope="col">Listing</th>
        <th scope="col" class="num">Our price</th>
        <th scope="col" class="num">Market</th>
        <th scope="col">Recommend</th>
        <th scope="col">vs market</th>
        <th scope="col">Confidence</th>
        <th scope="col">Data</th>
      </tr>
    </thead>
    <tbody>
      <% rows.each do |row| %>
        <% snap = row.snapshot %>
        <tr data-pricing-game="<%= row.game.id %>">
          <td class="whitespace-nowrap">
            <div class="flex items-center gap-2">
              <%= link_to row.game.opponent.name, game_path(row.game), class: "text-content-strong font-medium hover:text-accent" %>
              <%= seat_map_button(row.game) if snap %>
            </div>
            <div class="text-xs text-muted"><%= game_when(row.game) %></div>
          </td>
          <td><%= listing_status_chip(row.status) %></td>
          <td class="num figure"><%= row.our_all_in ? dollars(row.our_all_in) : "—" %></td>
          <td class="num figure">
            <%= dollars(snap&.market_value) %>
            <% if snap&.market_value_change_pct %>
              <div class="text-xs <%= snap.market_value_change_pct.negative? ? "text-warning" : "text-content-dim" %>">
                <%= snap.market_value_change_pct.positive? ? "+" : "" %><%= snap.market_value_change_pct.round %>% wk
              </div>
            <% end %>
          </td>
          <td class="whitespace-nowrap">
            <% if snap&.recommended_list_price %>
              <span class="text-content-strong font-semibold figure">List <%= dollars(snap.recommended_list_price) %></span>
              <div class="text-xs text-muted"><%= strategy_label(snap.recommended_strategy) %> · <%= dollars(snap.recommended_all_in) %> all-in</div>
            <% else %>
              <span class="text-muted">—</span>
            <% end %>
          </td>
          <td><%= assessment_chip(row.assessment) %></td>
          <td><%= confidence_chip(row.confidence) if snap %></td>
          <td><%= freshness_chip(snap) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%# Phone cards %>
<ul class="space-y-3 lg:hidden">
  <% rows.each do |row| %>
    <% snap = row.snapshot %>
    <li class="relative">
      <%= link_to game_path(row.game), class: "card block hover:border-accent transition-colors", data: { pricing_game: row.game.id } do %>
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="font-bold text-content-strong truncate">vs <%= row.game.opponent.name %></p>
            <p class="text-sm text-content-dim"><%= game_when(row.game) %></p>
          </div>
          <%= assessment_chip(row.assessment) %>
        </div>
        <div class="grid grid-cols-3 gap-2 mt-3 pt-3 border-t border-subtle text-sm">
          <div>
            <p class="text-xs text-muted">Ours</p>
            <p class="font-semibold text-content-strong figure"><%= row.our_all_in ? dollars(row.our_all_in) : "—" %></p>
          </div>
          <div>
            <p class="text-xs text-muted">Market</p>
            <p class="font-semibold text-content-strong figure"><%= dollars(snap&.market_value) %></p>
          </div>
          <div>
            <p class="text-xs text-muted">List at</p>
            <p class="font-semibold text-content-strong figure"><%= dollars(snap&.recommended_list_price) %></p>
          </div>
        </div>
        <div class="flex flex-wrap gap-1.5 mt-3 <%= "pr-16" if snap %>">
          <%= listing_status_chip(row.status) %>
          <%= confidence_chip(row.confidence) if snap %>
          <%= freshness_chip(snap) %>
        </div>
      <% end %>
      <%# Beside the card's link, not in it: a link can't hold another. %>
      <% if snap %>
        <div class="absolute bottom-4 right-4"><%= seat_map_button(row.game) %></div>
      <% end %>
    </li>
  <% end %>
</ul>
