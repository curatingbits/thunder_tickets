<%# The 3D seat map switch. A link, so it works before any JavaScript; the
    choice is remembered on this device (PricingController#map_on?). %>
<%= link_to pricing_path(filter: (@filter unless @filter == PricingController::DEFAULT_FILTER), map: (@map ? "off" : "on")),
      role: "switch", aria: { checked: @map.to_s }, data: { turbo_action: "replace", seat_map_switch: true },
      class: "inline-flex items-center gap-2 text-sm font-medium text-content-strong hover:text-accent" do %>
  <span class="relative inline-flex h-6 w-10 shrink-0 rounded-full transition-colors <%= @map ? "bg-accent" : "bg-strong" %>">
    <span class="absolute top-0.5 h-5 w-5 rounded-full bg-white shadow transition-transform <%= @map ? "translate-x-[1.125rem]" : "translate-x-0.5" %>"></span>
  </span>
  3D seat map
<% end %>
