<% content_for :title, "Edit listing · MADR TICKETS" %>

<div class="max-w-xl mx-auto space-y-6">
  <div>
    <%= link_to "← #{@game.opponent.name}", game_path(@game), class: "text-accent hover:brightness-125 text-sm" %>
    <h1 class="text-2xl sm:text-3xl font-bold text-content-strong mt-2"><%= @listing.hold? ? "Edit hold" : "Edit listing" %></h1>
    <p class="text-sm text-content-dim mt-1">vs <%= @game.opponent.name %> · <%= game_when(@game) %></p>
    <p class="text-sm text-muted mt-2">Saving also records that you checked it just now.</p>
  </div>

  <div class="card">
    <%= render "form", listing: @listing %>
  </div>
</div>
