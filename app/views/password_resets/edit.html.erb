<div class="min-h-screen flex items-center justify-center bg-canvas py-12 px-4">
  <div class="max-w-md w-full space-y-8">
    <div>
      <h1 class="flex justify-center">
        <%= render "shared/logo_stacked", class: "h-36 w-auto" %>
      </h1>
      <h2 class="mt-6 text-center text-3xl font-extrabold text-content-strong">
        Set New Password
      </h2>
    </div>

    <%= form_with url: password_reset_path(params[:id]), method: :patch, class: "mt-8 space-y-6" do %>
      <div>
        <label for="password" class="block text-sm font-medium text-content mb-2">New Password</label>
        <%= password_field_tag :password, nil, placeholder: "Enter new password", class: "input-field", required: true, minlength: 6, autofocus: true %>
        <p class="mt-1 text-xs text-muted">At least 6 characters</p>
      </div>

      <div>
        <label for="password_confirmation" class="block text-sm font-medium text-content mb-2">Confirm Password</label>
        <%= password_field_tag :password_confirmation, nil, placeholder: "Confirm new password", class: "input-field", required: true %>
      </div>

      <div>
        <%= submit_tag "Reset Password", class: "w-full btn-primary text-lg py-3" %>
      </div>
    <% end %>
  </div>
</div>
