<%# Desktop navigation (lg and up). Phones get _top_bar and _bottom_nav instead. %>
<aside class="hidden lg:flex lg:flex-col lg:fixed lg:inset-y-0 lg:left-0 lg:w-64 bg-surface border-r border-subtle z-40" data-shell="sidebar">
  <div class="h-16 shrink-0 flex items-center px-6 border-b border-subtle">
    <%= link_to root_path, class: "text-xl font-bold" do %>
      <span class="text-accent">MADR</span> <span class="text-accent-alt">TICKETS</span>
    <% end %>
  </div>

  <nav class="flex-1 overflow-y-auto px-3 py-4" aria-label="Main">
    <ul class="space-y-1">
      <% primary_nav_items.each do |item| %>
        <li>
          <%= link_to item.path,
                class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium #{item.active ? "bg-surface-raised text-accent" : "text-content hover:bg-surface-raised hover:text-content-strong"}",
                aria: { current: (item.active ? "page" : nil) } do %>
            <%= icon(item.icon, "h-5 w-5") %>
            <%= item.label %>
          <% end %>
        </li>
      <% end %>
    </ul>

    <p class="section-label px-3 mt-8 mb-2">Manage</p>
    <ul class="space-y-1">
      <% secondary_nav_items.each do |item| %>
        <li>
          <%= link_to item.path,
                class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium #{item.active ? "bg-surface-raised text-accent" : "text-content hover:bg-surface-raised hover:text-content-strong"}",
                aria: { current: (item.active ? "page" : nil) } do %>
            <%= icon(item.icon, "h-5 w-5") %>
            <%= item.label %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>

  <div class="shrink-0 p-4 border-t border-subtle space-y-3">
    <%= render "shared/theme_picker" %>
    <%= render "layouts/season_indicator" %>
    <p class="text-sm text-content-dim">Signed in as <span class="text-content-strong"><%= current_user.name %></span></p>
    <%= button_to logout_path, method: :delete, class: "btn-secondary w-full text-sm gap-2" do %>
      <%= icon(:logout, "h-4 w-4") %> Log out
    <% end %>
  </div>
</aside>
