<%# The research panel on Pricing: Update prices, and where research has got
    to. ResearchPanel decides what it shows. research_panel_controller.js
    re-reads it while an update waits or runs, and reloads the page when a
    run finishes so the board shows the new prices. %>
<% alert = local_assigns[:alert] %>
<%= turbo_frame_tag "research_panel", class: "block", data: { controller: "research-panel", research_panel_url_value: research_requests_path,
                                              research_panel_interval_value: Rails.configuration.x.research_panel_poll_ms } do %>
  <div class="card py-4" data-research-panel data-research-state="<%= panel.state %>">
    <% if alert %>
      <p class="text-sm text-warning mb-3" role="alert"><%= alert %></p>
    <% end %>

    <% case panel.state %>
    <% when :running %>
      <% read, of = panel.progress %>
      <% asked = panel.run_request %>
      <div class="space-y-2" role="status">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <p class="font-semibold text-content-strong">
            <span class="inline-block h-2 w-2 rounded-full bg-accent motion-safe:animate-pulse mr-1.5 align-middle" aria-hidden="true"></span>
            Researching prices: <span class="figure"><%= read %></span> of <span class="figure"><%= of %></span> games read
          </p>
          <%= link_to "Research runs →", import_runs_path, class: "text-sm text-accent hover:brightness-125", data: { turbo_frame: "_top" } %>
        </div>
        <div class="h-1.5 rounded-full bg-strong overflow-hidden" role="progressbar" aria-label="Games read"
             aria-valuemin="0" aria-valuemax="<%= of %>" aria-valuenow="<%= read %>">
          <div class="h-full rounded-full bg-accent" style="width: <%= of.positive? ? (100.0 * read / of).round : 0 %>%"></div>
        </div>
        <p class="text-sm text-content-dim">
          <%= asked ? "#{asked.scope_label}, asked for by #{asked.user.name}" : "The scheduled research" %>,
          started <%= time_ago_in_words(panel.live_run.started_at) %> ago. The board refreshes when it finishes.
        </p>
      </div>

    <% when :starting %>
      <div role="status">
        <p class="font-semibold text-content-strong">Starting on Duggan's computer…</p>
        <p class="text-sm text-content-dim mt-1">
          <%= panel.request.scope_label %>, asked for by <%= panel.request.user.name %>. Reading should begin in a minute or two.
        </p>
      </div>

    <% when :pending %>
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3" role="status">
        <div>
          <p class="font-semibold text-content-strong">Waiting for Duggan's computer</p>
          <p class="text-sm text-content-dim mt-1">
            <%= panel.request.scope_label %>, asked for by <%= panel.request.user.name %>
            <%= time_ago_in_words(panel.request.created_at) %> ago. The computer checks every couple of minutes;
            if it doesn't pick this up within an hour, the request lapses.
          </p>
        </div>
        <%= button_to "Cancel", cancel_research_request_path(panel.request),
              class: "btn-secondary text-sm py-1.5 px-3 min-h-[36px]", form_class: "shrink-0" %>
      </div>

    <% else %>
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
        <div class="min-w-0 text-sm">
          <% if (run = panel.last_run) %>
            <%= link_to import_runs_path, class: "text-accent hover:brightness-125", data: { turbo_frame: "_top" } do %>
              Last research: <%= run.status %>, <%= time_ago_in_words(run.finished_at || run.started_at) %> ago →
            <% end %>
          <% else %>
            <%= link_to "Research runs →", import_runs_path, class: "text-accent hover:brightness-125", data: { turbo_frame: "_top" } %>
          <% end %>
          <% if (note = panel.note) %>
            <p class="text-warning mt-1" data-research-note><%= note %></p>
          <% end %>
          <% if (reason = panel.unavailable_reason) %>
            <p class="text-content-dim mt-1" data-research-unavailable><%= reason %></p>
          <% end %>
        </div>

        <% unless panel.unavailable_reason %>
          <details class="shrink-0 sm:text-right" data-research-update>
            <summary class="btn-primary text-sm py-1.5 px-3 min-h-[36px] cursor-pointer select-none">
              <%= icon(:refresh, "h-4 w-4 mr-1.5") %>Update prices
            </summary>
            <div class="mt-3 flex flex-col sm:flex-row gap-2 sm:justify-end">
              <% panel.choices.each do |choice| %>
                <%= button_to research_requests_path, params: { scope: choice[:scope] }, disabled: choice[:games].zero?,
                      form_class: "w-full sm:w-auto", data: { research_scope: choice[:scope] },
                      class: "btn-secondary w-full sm:w-auto text-sm py-2 px-3 flex-col disabled:opacity-50" do %>
                  <span><%= choice[:label] %></span>
                  <span class="text-xs font-normal text-content-dim">
                    <%= choice[:games].zero? ? "no games" : "#{pluralize(choice[:games], "game")} · #{choice[:estimate]}" %>
                  </span>
                <% end %>
              <% end %>
            </div>
            <p class="text-xs text-muted mt-2 sm:max-w-sm sm:ml-auto">
              Duggan's computer picks it up within a couple of minutes and reads Ticketmaster just like the scheduled research.
            </p>
          </details>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
