<%# Q5 on Home: what's still owed, what needs a look, and the latest Venmo
    payments, in Money's format. %>
<% totals = summary.totals %>
<% review = summary.review.count %>
<% recent = summary.recent(3) %>
<div class="card" data-settlement-tile>
  <% if summary.synced? %>
    <p class="text-2xl font-bold text-content-strong"><%= owes_sentence(totals[:outstanding_cents]) %></p>
  <% else %>
    <p class="text-lg font-semibold text-content-strong">Waiting for the first Venmo sync</p>
  <% end %>
  <p class="text-sm text-content-dim mt-1">
    <%= summary.synced? ? "#{pluralize(totals[:unpaid_games], "game")} not fully paid" : "#{cents(totals[:expected_cents], signed: true)} owed so far on sold games" %>
    <% if review.positive? %> · <%= link_to pluralize(review, "payment") + " to review", partner_payments_path(filter: "review"), class: "text-accent" %><% end %>
  </p>
  <% if recent.any? %>
    <p class="text-xs text-muted mt-4">Latest Venmo payments</p>
    <ul class="-mx-4 sm:-mx-6 mt-2 border-y border-subtle divide-y divide-subtle" data-recent-payments>
      <%= render partial: "partner_payments/payment", collection: recent %>
    </ul>
  <% end %>
  <p class="text-xs text-muted mt-3">
    <%= summary.last_sync_at ? "Venmo synced #{time_ago_in_words(summary.last_sync_at)} ago" : "Venmo not synced yet" %>
  </p>
</div>
