<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4">
    <div>
      <h1 class="text-3xl sm:text-4xl font-bold text-content-strong">Games</h1>
      <p class="text-content-dim mt-2"><%= @season.year %> Season • <%= @games.count %> games</p>
    </div>
    <div class="flex flex-col items-start sm:items-end gap-2">
      <%= render "shared/season_switcher",
                 seasons: @seasons,
                 selected: @season,
                 path: ->(s) { games_path(season_id: s.id, filter: params[:filter]) } %>
      <% if viewing_current_season? %>
        <%= link_to "Add Game", new_game_path, class: "btn-primary w-full sm:w-auto text-center" %>
      <% end %>
    </div>
  </div>

  <!-- Filters -->
  <div class="card">
    <div class="flex flex-wrap gap-2">
      <% filters = [["All Games", nil], ["Upcoming", :upcoming], ["Past", :past], ["Fully Sold", :sold], ["Unsold", :unsold]] %>
      <% filters.insert(1, ["Needs attention", :attention]) if viewing_current_season? %>
      <% filters.each do |label, filter| %>
        <% active = params[:filter].presence == filter&.to_s %>
        <%= link_to label,
                    games_path(season_scope_params.merge(filter: filter).compact),
                    class: "px-4 py-2 rounded-lg #{active ? 'bg-accent text-canvas font-semibold' : 'bg-surface-raised text-content hover:bg-strong'}" %>
      <% end %>
    </div>
  </div>

  <% if @games.any? %>
    <%
      totals = @games.reduce({ sold: 0, seats: 0, cost: 0, revenue: 0, profit: 0 }) do |acc, g|
        acc[:sold]    += g.tickets_sold_count
        acc[:seats]   += @season.num_seats
        acc[:cost]    += g.total_cost
        acc[:revenue] += g.total_revenue
        acc[:profit]  += g.profit_loss
        acc
      end
      # Nothing sold means there is no profit or loss yet, only commitment.
      nothing_sold = totals[:sold].zero?
    %>

    <!-- ============================================================
         Desktop: a real table. 42 games is tabular data, not 42 cards.
         ============================================================ -->
    <div class="card hidden lg:block p-0 overflow-hidden">
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col">Date</th>
            <th scope="col">Opponent</th>
            <th scope="col">Type</th>
            <th scope="col" class="num">Sold</th>
            <th scope="col" class="num">Cost</th>
            <th scope="col" class="num">Revenue</th>
            <th scope="col" class="num">P/L</th>
          </tr>
        </thead>
        <tbody>
          <% @games.each do |game| %>
            <% pending = game.tickets_sold_count.zero? && game.game_date >= Date.current %>
            <tr class="cursor-pointer" onclick="window.location='<%= game_path(game) %>'">
              <td class="whitespace-nowrap">
                <span class="text-content-strong font-medium"><%= game.game_date.strftime("%b %-d") %></span>
                <span class="text-muted text-xs ml-1"><%= game.game_date.strftime("%Y") %></span>
                <span class="ml-2"><%= countdown_chip(game) %></span>
              </td>
              <td>
                <%= link_to game, class: "text-content-strong font-medium hover:text-accent transition-colors" do %>
                  <%= game.opponent.name %>
                <% end %>
              </td>
              <td>
                <% if game.playoff? %>
                  <span class="inline-block px-2 py-0.5 text-xs bg-warning/20 text-warning rounded"><%= game.playoff_round.presence || "Playoff" %></span>
                <% elsif game.cup_round %>
                  <span class="inline-block px-2 py-0.5 text-xs bg-highlight/20 text-highlight rounded">NBA Cup</span>
                <% elsif game.preseason? %>
                  <span class="inline-block px-2 py-0.5 text-xs bg-surface-raised text-content-dim rounded">Preseason</span>
                <% else %>
                  <span class="text-muted text-xs">Regular</span>
                <% end %>
              </td>
              <td class="num">
                <span class="<%= game.fully_sold? ? 'text-positive' : game.partially_sold? ? 'text-warning' : 'text-muted' %>">
                  <%= game.tickets_sold_count %>/<%= @season.num_seats %>
                </span>
              </td>
              <!-- Cost is a neutral fact, not bad news: no red. -->
              <td class="num text-content-dim">$<%= number_with_delimiter(game.total_cost.round) %></td>
              <td class="num <%= game.total_revenue.positive? ? 'text-content' : 'text-muted' %>">
                $<%= number_with_delimiter(game.total_revenue.round) %>
              </td>
              <td class="num font-semibold <%= pending ? 'text-muted' : game.profit_loss.positive? ? 'text-positive' : game.profit_loss.negative? ? 'text-negative' : 'text-muted' %>">
                <%# An unsold future game hasn't lost money — it just hasn't
                    sold yet. Showing its full cost as a red loss is alarming
                    and wrong. %>
                <% if pending %>
                  —
                <% else %>
                  <%= signed_currency(game.profit_loss) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr class="bg-surface-raised border-t-2 border-strong font-semibold">
            <td colspan="3" class="text-content-dim uppercase text-xs tracking-wider">
              Season total · <%= @games.size %> games
            </td>
            <td class="num text-content"><%= totals[:sold] %>/<%= totals[:seats] %></td>
            <td class="num text-content-dim">$<%= number_with_delimiter(totals[:cost].round) %></td>
            <td class="num text-content">$<%= number_with_delimiter(totals[:revenue].round) %></td>
            <td class="num <%= nothing_sold ? 'text-muted' : totals[:profit].positive? ? 'text-positive' : totals[:profit].negative? ? 'text-negative' : 'text-muted' %>">
              <% if nothing_sold %>
                —
              <% else %>
                <%= signed_currency(totals[:profit]) %>
              <% end %>
            </td>
          </tr>
        </tfoot>
      </table>
    </div>

    <!-- ============================================================
         Mobile: cards, which is the right shape on a narrow screen.
         ============================================================ -->
    <div class="space-y-3 lg:hidden">
      <% @games.each do |game| %>
        <% pending = game.tickets_sold_count.zero? && game.game_date >= Date.current %>
        <%= link_to game, class: "card block hover:border-accent transition-colors" do %>
          <div class="flex items-start justify-between gap-3">
            <div class="flex items-start gap-3 min-w-0">
              <div class="text-center min-w-[48px]">
                <div class="text-xs text-content-dim"><%= game.game_date.strftime("%b") %></div>
                <div class="text-2xl font-bold text-content-strong figure"><%= game.game_date.strftime("%-d") %></div>
              </div>
              <div class="border-l border-subtle pl-3 min-w-0">
                <h3 class="font-bold text-content-strong truncate"><%= game.opponent.name %></h3>
                <% if (chip = countdown_chip(game)) %>
                  <div class="mt-1"><%= chip %></div>
                <% end %>
                <p class="text-xs text-muted mt-0.5">
                  <% if game.playoff? %>
                    <%= game.playoff_round.presence || "Playoff" %>
                  <% elsif game.cup_round %>
                    NBA Cup
                  <% elsif game.preseason? %>
                    Preseason
                  <% else %>
                    Game #<%= game.game_number %>
                  <% end %>
                </p>
              </div>
            </div>
            <div class="text-right flex-shrink-0">
              <div class="font-bold figure <%= pending ? 'text-muted' : game.profit_loss.positive? ? 'text-positive' : game.profit_loss.negative? ? 'text-negative' : 'text-muted' %>">
                <% if pending %>
                  —
                <% else %>
                  <%= signed_currency(game.profit_loss) %>
                <% end %>
              </div>
              <div class="text-xs mt-0.5 <%= game.fully_sold? ? 'text-positive' : game.partially_sold? ? 'text-warning' : 'text-muted' %>">
                <%= game.tickets_sold_count %>/<%= @season.num_seats %> sold
              </div>
            </div>
          </div>
          <div class="flex gap-4 mt-3 pt-3 border-t border-subtle text-xs">
            <div><span class="text-muted">Cost</span> <span class="text-content-dim figure">$<%= number_with_delimiter(game.total_cost.round) %></span></div>
            <div><span class="text-muted">Revenue</span> <span class="text-content figure">$<%= number_with_delimiter(game.total_revenue.round) %></span></div>
          </div>
        <% end %>
      <% end %>

      <div class="card bg-surface-raised">
        <div class="flex justify-between items-center">
          <span class="section-label">Season total · <%= @games.size %> games</span>
          <span class="font-bold figure <%= nothing_sold ? 'text-muted' : totals[:profit].positive? ? 'text-positive' : totals[:profit].negative? ? 'text-negative' : 'text-muted' %>">
            <% if nothing_sold %>
              $<%= number_with_delimiter(totals[:cost].round) %> committed
            <% else %>
              <%= signed_currency(totals[:profit]) %>
            <% end %>
          </span>
        </div>
      </div>
    </div>
  <% else %>
    <div class="card text-center py-12">
      <p class="text-content-dim text-lg">No games found</p>
    </div>
  <% end %>
</div>
