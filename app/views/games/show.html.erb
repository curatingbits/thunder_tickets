<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-4">
    <div class="flex-1">
      <%= link_to "← Back to Games", games_path, class: "text-accent hover:brightness-125 text-sm mb-2 inline-block" %>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-content-strong">vs <%= @game.opponent.name %></h1>
      <p class="text-sm sm:text-base text-content-dim mt-2">
        <%= @game.game_date.strftime("%A, %B %d, %Y") %><br class="sm:hidden">
        <span class="sm:before:content-['•'] sm:before:mx-2">Game #<%= @game.game_number %></span>
        <% if @game.playoff? %>
          <br class="sm:hidden">
          <span class="sm:before:content-['•'] sm:before:mx-2 text-warning"><%= @game.playoff_round %></span>
        <% elsif @game.cup_round %>
          <br class="sm:hidden">
          <span class="sm:before:content-['•'] sm:before:mx-2 text-purple-400">NBA Cup: <%= @game.cup_round %></span>
        <% elsif @game.preseason? %>
          <br class="sm:hidden">
          <span class="sm:before:content-['•'] sm:before:mx-2 text-sky-400">Preseason</span>
        <% end %>
      </p>
    </div>
    <div class="w-full sm:w-auto">
      <%= link_to "Edit Game", edit_game_path(@game), class: "btn-secondary w-full sm:w-auto text-center" %>
    </div>
  </div>

  <!-- Financial Summary -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
    <div class="stat-card">
      <p class="text-xs sm:text-sm text-content-dim">Total Cost</p>
      <p class="text-xl sm:text-2xl font-bold text-negative">$<%= number_with_delimiter(@game.total_cost.round) %></p>
      <p class="text-xs text-muted mt-1 hidden sm:block">
        $<%= number_with_delimiter(@game.cost_per_ticket) %>/ticket
      </p>
    </div>

    <div class="stat-card">
      <p class="text-xs sm:text-sm text-content-dim">Total Revenue</p>
      <p class="text-xl sm:text-2xl font-bold text-positive">$<%= number_with_delimiter(@game.total_revenue.round) %></p>
      <p class="text-xs text-muted mt-1"><%= @game.tickets_sold_count %> sold</p>
    </div>

    <div class="stat-card">
      <p class="text-xs sm:text-sm text-content-dim">Profit/Loss</p>
      <p class="text-xl sm:text-2xl font-bold <%= @game.profit_loss >= 0 ? 'text-positive' : 'text-negative' %>">
        <%= @game.profit_loss >= 0 ? '+' : '' %>$<%= number_with_delimiter(@game.profit_loss.round) %>
      </p>
      <p class="text-xs text-muted mt-1">
        <%= @game.total_revenue > 0 ? ((@game.total_revenue / @game.total_cost - 1) * 100).round(1) : 0 %>% ROI
      </p>
    </div>

    <div class="stat-card">
      <p class="text-xs sm:text-sm text-content-dim">Status</p>
      <p class="text-xl sm:text-2xl font-bold <%= @game.fully_sold? ? 'text-positive' : @game.partially_sold? ? 'text-warning' : 'text-negative' %>">
        <%= @game.tickets_available %> Left
      </p>
      <p class="text-xs text-muted mt-1">
        <%= ((@game.tickets_sold_count.to_f / @season.num_seats) * 100).round(0) %>% sold
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Left Column: Ticket Sales Management + Receipt -->
    <div class="space-y-6">
      <div class="card">
      <h2 class="text-2xl font-bold text-content-strong mb-4">Manage Tickets</h2>

      <!-- Existing Tickets -->
      <div class="space-y-3 mb-6">
        <% if @game.tickets.any? %>
          <% @game.tickets.order(:seat_number).each do |ticket| %>
            <div class="bg-canvas rounded-lg p-4 border border-subtle">
              <div class="flex justify-between items-start">
                <div>
                  <p class="font-semibold text-content-strong">Section <%= ticket.section %>, Row <%= ticket.row %>, Seat <%= ticket.seat_number %></p>
                  <p class="text-sm text-content-dim">
                    Sold for <span class="text-positive font-semibold">$<%= number_with_delimiter(ticket.sale_price) %></span>
                  </p>
                  <% if ticket.buyer.present? %>
                    <p class="text-xs text-muted mt-1">
                      Buyer: <%= link_to ticket.buyer.name, ticket.buyer, class: "text-accent hover:brightness-125" %>
                      <% if ticket.buyer.email.present? %>
                        <span class="text-muted">(<%= ticket.buyer.email %>)</span>
                      <% end %>
                    </p>
                  <% end %>
                  <% if ticket.notes.present? %>
                    <p class="text-xs text-content-dim mt-1"><%= ticket.notes %></p>
                  <% end %>
                </div>
                <div class="text-right">
                  <p class="text-sm <%= ticket.sale_price > @game.cost_per_ticket ? 'text-positive' : 'text-negative' %>">
                    <%= ((ticket.sale_price / @game.cost_per_ticket - 1) * 100).round(0) %>%
                  </p>
                  <%= button_to "Remove", game_ticket_path(@game, ticket), method: :delete,
                      data: { turbo_confirm: "Are you sure?" },
                      class: "text-xs text-negative hover:text-negative mt-2" %>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <p class="text-content-dim text-center py-4">No tickets sold yet</p>
        <% end %>
      </div>

      <!-- Add New Ticket Sale -->
      <% if @available_seats.any? %>
        <div class="border-t border-subtle pt-6" data-controller="bulk-sale" data-bulk-sale-available-count-value="<%= @available_seats.count %>">
          <h3 class="text-lg font-semibold text-content-strong mb-4">Record New Sale</h3>

          <!-- Tab Buttons -->
          <div class="flex mb-4 border-b border-subtle">
            <button type="button"
                    class="px-4 py-2 text-sm font-medium rounded-t-lg bg-blue-600 text-content-strong"
                    data-bulk-sale-target="singleTab"
                    data-action="click->bulk-sale#showSingle">
              Single Sale
            </button>
            <button type="button"
                    class="px-4 py-2 text-sm font-medium rounded-t-lg bg-surface-raised text-content hover:bg-strong"
                    data-bulk-sale-target="bulkTab"
                    data-action="click->bulk-sale#showBulk">
              Bulk Sale (<%= @available_seats.count %>)
            </button>
          </div>

          <!-- Single Sale Form -->
          <div data-bulk-sale-target="singleForm">
            <%= form_with model: [@game, Ticket.new],
                          class: "space-y-4",
                          data: {
                            controller: "ticket-form",
                            action: "submit->ticket-form#submit"
                          } do |f| %>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                  <label class="block text-sm font-medium text-content mb-2">Section</label>
                  <%= f.text_field :section, value: "101", class: "input-field" %>
                </div>

                <div>
                  <label class="block text-sm font-medium text-content mb-2">Row</label>
                  <%= f.text_field :row, value: "DD", class: "input-field" %>
                </div>

                <div>
                  <label class="block text-sm font-medium text-content mb-2">Seat Number</label>
                  <%= f.select :seat_number, @available_seats.map { |s| [s, s] },
                      { prompt: "Select seat" },
                      class: "input-field" %>
                </div>
              </div>

              <div>
                <label class="block text-sm font-medium text-content mb-2">Sale Price</label>
                <%= f.number_field :sale_price, step: 0.01, placeholder: @game.cost_per_ticket.to_s,
                    class: "input-field" %>
              </div>

              <div data-controller="buyer-form">
                <div>
                  <label class="block text-sm font-medium text-content mb-2">Buyer (Optional)</label>
                  <%= f.select :buyer_id,
                      [["+ Create New Buyer", "new"]] + @buyers.map { |b| [b.name + (b.email.present? ? " (#{b.email})" : ""), b.id] },
                      { prompt: "Select buyer (optional)" },
                      class: "input-field",
                      data: {
                        buyer_form_target: "select",
                        action: "change->buyer-form#toggleForm"
                      } %>
                  <p class="mt-1 text-xs text-muted">Link this sale to an existing buyer or create a new one</p>
                </div>

                <!-- Inline buyer creation form (hidden by default) -->
                <div class="mt-6 hidden" data-buyer-form-target="formContainer">
                  <%= render "buyers/inline_form", buyer: Buyer.new %>
                </div>
              </div>

              <div>
                <label class="block text-sm font-medium text-content mb-2">Notes (Optional)</label>
                <%= f.text_area :notes, rows: 2, placeholder: "Any additional notes...", class: "input-field" %>
              </div>

              <%= f.submit "Record Sale", class: "btn-success w-full" %>
            <% end %>
          </div>

          <!-- Bulk Sale Form -->
          <div class="hidden" data-bulk-sale-target="bulkForm">
            <%= form_with url: bulk_create_game_tickets_path(@game), method: :post, class: "space-y-4", data: { controller: "ticket-form", action: "submit->ticket-form#submit" } do |f| %>
              <div>
                <label class="block text-sm font-medium text-content mb-2">Total Sale Amount</label>
                <%= f.number_field :total_amount, step: 0.01, placeholder: (@game.cost_per_ticket * @available_seats.count).to_s,
                    class: "input-field",
                    data: {
                      bulk_sale_target: "totalAmount",
                      action: "input->bulk-sale#updatePreview"
                    } %>
                <p class="mt-2 text-sm text-accent hidden" data-bulk-sale-target="pricePreview"></p>
              </div>

              <div data-controller="buyer-form">
                <div>
                  <label class="block text-sm font-medium text-content mb-2">Buyer (Optional)</label>
                  <%= f.select :buyer_id,
                      [["+ Create New Buyer", "new"]] + @buyers.map { |b| [b.name + (b.email.present? ? " (#{b.email})" : ""), b.id] },
                      { prompt: "Select buyer (optional)" },
                      class: "input-field",
                      data: {
                        buyer_form_target: "select",
                        action: "change->buyer-form#toggleForm"
                      } %>
                  <p class="mt-1 text-xs text-muted">This buyer will be assigned to all <%= @available_seats.count %> tickets</p>
                </div>

                <!-- Inline buyer creation form (hidden by default) -->
                <div class="mt-6 hidden" data-buyer-form-target="formContainer">
                  <%= render "buyers/inline_form", buyer: Buyer.new %>
                </div>
              </div>

              <div>
                <label class="block text-sm font-medium text-content mb-2">Notes (Optional)</label>
                <%= f.text_area :notes, rows: 2, placeholder: "Any additional notes...", class: "input-field" %>
              </div>

              <%= f.submit "Record All #{@available_seats.count} Tickets", class: "btn-success w-full" %>
            <% end %>
          </div>
        </div>
      <% else %>
        <div class="border-t border-subtle pt-6">
          <p class="text-center text-positive font-semibold">All tickets for this game have been sold!</p>
        </div>
      <% end %>
      </div>

      <!-- Receipt Image -->
      <div class="card">
        <h3 class="text-lg font-semibold text-content-strong mb-4">Receipt</h3>
        <% if @game.receipt_image.attached? %>
          <%= image_tag @game.receipt_image, class: "max-w-full rounded-lg mb-4" %>
        <% end %>
        <%= form_with model: @game, url: game_path(@game), method: :patch, class: "space-y-3" do |f| %>
          <%= f.file_field :receipt_image, accept: "image/*", class: "input-field" %>
          <p class="text-xs text-muted">Max 15MB. Accepts JPG, PNG, HEIC.</p>
          <%= f.submit @game.receipt_image.attached? ? "Replace Image" : "Upload Image", class: "btn-secondary w-full" %>
        <% end %>
      </div>
    </div>

    <!-- Game Statistics -->
    <div class="space-y-6">
      <!-- Average Sale Price -->
      <div class="card">
        <h2 class="text-2xl font-bold text-content-strong mb-4">Sale Statistics</h2>
        <div class="space-y-4">
          <% if @game.tickets.any? %>
            <div>
              <p class="text-sm text-content-dim">Average Sale Price</p>
              <p class="text-3xl font-bold text-accent">
                $<%= number_with_delimiter(@game.tickets.average(:sale_price).round(2)) %>
              </p>
            </div>

            <div>
              <p class="text-sm text-content-dim">Highest Sale</p>
              <p class="text-2xl font-bold text-positive">
                $<%= number_with_delimiter(@game.tickets.maximum(:sale_price)) %>
              </p>
            </div>

            <div>
              <p class="text-sm text-content-dim">Lowest Sale</p>
              <p class="text-2xl font-bold text-warning">
                $<%= number_with_delimiter(@game.tickets.minimum(:sale_price)) %>
              </p>
            </div>

            <div>
              <p class="text-sm text-content-dim">Average Markup</p>
              <p class="text-2xl font-bold <%= (@game.tickets.average(:sale_price) > @game.cost_per_ticket) ? 'text-positive' : 'text-negative' %>">
                <%= ((@game.tickets.average(:sale_price) / @game.cost_per_ticket - 1) * 100).round(1) %>%
              </p>
            </div>
          <% else %>
            <p class="text-content-dim text-center py-4">No sales data yet</p>
          <% end %>
        </div>
      </div>

      <!-- Break Even Calculator -->
      <div class="card bg-accent/10 border-blue-700">
        <h3 class="text-lg font-bold text-accent mb-3">Break Even Info</h3>
        <p class="text-sm text-content mb-2">
          Cost per ticket: <span class="text-content-strong font-semibold">$<%= number_with_delimiter(@game.cost_per_ticket) %></span>
        </p>
        <p class="text-sm text-content mb-2">
          Your share of parking: <span class="text-content-strong font-semibold">$<%= number_with_delimiter(@game.parking_cost / @season.num_seats) %></span>
        </p>
        <p class="text-sm text-content mb-4">
          Break even price per ticket: <span class="text-warning font-bold">$<%= number_with_delimiter(@game.total_cost / @season.num_seats) %></span>
        </p>
        <% if @game.tickets_available > 0 %>
          <p class="text-xs text-content-dim">
            You need to sell <%= @game.tickets_available %> remaining ticket<%= @game.tickets_available == 1 ? '' : 's' %>
            at $<%= number_with_delimiter(((@game.total_cost - @game.total_revenue) / @game.tickets_available).round(2)) %>
            each to break even.
          </p>
        <% end %>
      </div>
    </div>
  </div>
</div>
