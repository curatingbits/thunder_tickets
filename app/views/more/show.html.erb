<% content_for :title, "More · MADR TICKETS" %>

<h1 class="text-2xl sm:text-3xl font-bold text-content-strong mb-6">More</h1>

<div class="card p-0 overflow-hidden">
  <ul class="divide-y divide-subtle">
    <% secondary_nav_items.each do |item| %>
      <li>
        <%= link_to item.path, class: "flex items-center gap-3 px-4 sm:px-6 py-4 text-content hover:bg-surface-raised hover:text-content-strong" do %>
          <%= icon(item.icon, "h-5 w-5 text-content-dim") %>
          <span class="flex-1 font-medium"><%= item.label %></span>
          <%= icon(:chevron_right, "h-5 w-5 text-muted") %>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>

<div class="card mt-6">
  <h2 class="section-label mb-3">Appearance</h2>
  <%= render "shared/theme_picker" %>
</div>

<div class="card mt-6 space-y-3">
  <%= render "layouts/season_indicator" %>
  <p class="text-sm text-content-dim">Signed in as <span class="text-content-strong"><%= current_user.name %></span></p>
  <%= button_to logout_path, method: :delete, class: "btn-secondary w-full gap-2" do %>
    <%= icon(:logout, "h-5 w-5") %> Log out
  <% end %>
</div>
