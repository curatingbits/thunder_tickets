<%# locals: breakdown (array of hashes from Season#profit_by_game_type) %>
<div class="card">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-bold text-content-strong">Profit by Game Type</h2>
    <span class="text-xs text-muted"><%= pluralize(breakdown.size, "type") %></span>
  </div>

  <% if breakdown.any? %>
    <div class="space-y-3">
      <% breakdown.each do |row| %>
        <% unsold = row[:tickets_sold].to_i.zero? %>
        <div class="bg-canvas rounded-lg p-4 border border-subtle">
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2">
              <span class="font-semibold text-content-strong"><%= row[:label] %></span>
              <span class="text-xs text-muted"><%= pluralize(row[:games_count], "game") %> &bull; <%= row[:tickets_sold] %> sold</span>
            </div>
            <%# With nothing sold, ROI is -100% by definition. That's arithmetic,
                not performance — don't render it as a red result. %>
            <% if unsold %>
              <span class="text-xs text-muted">Not yet sold</span>
            <% else %>
              <span class="text-sm font-bold figure <%= row[:roi] >= 0 ? 'text-positive' : 'text-negative' %>">
                <%= row[:roi] >= 0 ? '+' : '' %><%= row[:roi] %>% ROI
              </span>
            <% end %>
          </div>
          <div class="grid grid-cols-3 gap-3 text-center">
            <div>
              <p class="section-label">Cost</p>
              <%# Cost is a neutral fact, not bad news. %>
              <p class="text-sm font-bold text-content figure">$<%= number_with_delimiter(row[:cost].round) %></p>
            </div>
            <div>
              <p class="section-label">Revenue</p>
              <p class="text-sm font-bold figure <%= row[:revenue].positive? ? 'text-positive' : 'text-muted' %>">$<%= number_with_delimiter(row[:revenue].round) %></p>
            </div>
            <div>
              <p class="section-label">Profit</p>
              <% if unsold %>
                <p class="text-sm font-bold text-muted figure">—</p>
              <% else %>
                <p class="text-sm font-bold figure <%= row[:profit] >= 0 ? 'text-positive' : 'text-negative' %>">
                  <%= signed_currency(row[:profit]) %>
                </p>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-content-dim text-center py-8">No games yet</p>
  <% end %>
</div>
