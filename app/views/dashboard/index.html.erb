<div class="space-y-8 sm:space-y-10" data-controller="dashboard-charts">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-3xl sm:text-4xl font-bold text-content-strong">Dashboard</h1>
        <% if @is_recap %>
          <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-surface-raised text-content uppercase tracking-wide">Complete · Recap</span>
        <% else %>
          <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-positive/20 text-positive uppercase tracking-wide">Active</span>
        <% end %>
      </div>
      <p class="text-sm sm:text-base text-content-dim mt-1">Oklahoma City Thunder <%= @season.year %> Season</p>
    </div>
    <div class="flex flex-col items-start sm:items-end gap-2">
      <%= render "shared/season_switcher",
                 seasons: @seasons,
                 selected: @season,
                 path: ->(s) { dashboard_path(season_id: s.id) } %>
      <div class="flex items-center gap-3">
        <%= link_to "Weekly report →", weekly_report_path, class: "text-xs text-accent hover:brightness-125" unless @is_recap %>
        <%= link_to "All seasons →", seasons_path, class: "text-xs text-accent hover:brightness-125" %>
        <span class="text-xs text-muted">Updated <%= Time.current.strftime("%b %d, %I:%M %p") %></span>
      </div>
    </div>
  </div>

  <% if @attention %>
    <%= render "attention", items: @attention %>
  <% end %>

  <% if @board %>
    <%# How our prices compare, then the top of Pricing's Unsold list in the
        same format. %>
    <section class="space-y-3" data-dashboard-section="next-unsold">
      <div class="flex items-center justify-between">
        <h2 class="section-label">Next unsold games &amp; Pricing</h2>
        <%= link_to "All on Pricing →", pricing_path, class: "text-xs text-accent hover:brightness-125" %>
      </div>
      <%= render "pricing/vs_market_tile", counts: @pricing_counts %>
      <% if @next_unsold.any? %>
        <%= render "pricing/board", rows: @next_unsold %>
      <% else %>
        <p class="card text-sm text-content-dim">No unsold games coming up.</p>
      <% end %>
    </section>

    <% if @settlement_summary %>
      <section class="space-y-3" data-dashboard-section="payouts">
        <div class="flex items-center justify-between">
          <h2 class="section-label">Payouts</h2>
          <%= link_to "Money →", money_path, class: "text-xs text-accent hover:brightness-125" %>
        </div>
        <%= render "settlements/tile", summary: @settlement_summary %>
      </section>
    <% end %>
  <% end %>

  <% if @next_rows.present? %>
    <%= render "next_games", rows: @next_rows %>
  <% end %>

  <!-- ============================== -->
  <!-- ZONE 1: OVERVIEW               -->
  <!-- ============================== -->
  <section class="space-y-4">
    <h2 class="section-label">Overview</h2>

    <% if @not_started %>
      <!-- Pre-season: no tickets sold and no games played. Every ratio here
           is -100% or 0% by construction, so show the commitment instead. -->
      <div class="card">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
          <div>
            <p class="section-label">Season starts</p>
            <p class="text-3xl sm:text-4xl font-bold text-content-strong mt-1">
              <%= @season.first_game_date.strftime("%B %-d") %>
            </p>
            <p class="text-sm text-content-dim mt-1">
              <%= distance_of_time_in_words(Date.current, @season.first_game_date) %> away
              · <%= @season.year %> season
            </p>
          </div>

          <div class="grid grid-cols-3 gap-6 lg:gap-10">
            <div>
              <p class="section-label">Games</p>
              <p class="text-xl sm:text-2xl font-bold text-content mt-1 figure"><%= @metrics[:total_games] %></p>
            </div>
            <div>
              <p class="section-label">Tickets</p>
              <p class="text-xl sm:text-2xl font-bold text-content mt-1 figure"><%= number_with_delimiter(@metrics[:total_tickets]) %></p>
            </div>
            <div>
              <p class="section-label">Committed</p>
              <p class="text-xl sm:text-2xl font-bold text-content mt-1 figure">$<%= number_with_delimiter(@metrics[:total_cost].round) %></p>
            </div>
          </div>
        </div>

        <div class="mt-5 pt-5 border-t border-subtle flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <p class="text-sm text-content-dim">
            Break-even means clearing
            <span class="text-content-strong font-semibold figure">$<%= number_with_delimiter(@metrics[:total_cost].round) %></span>
            — all <%= number_with_delimiter(@metrics[:total_tickets]) %> seats at
            <span class="text-content-strong font-semibold figure">$<%= number_with_delimiter(@metrics[:average_cost_per_ticket].round) %></span>,
            or fewer at a higher price.
          </p>
          <%= link_to "View schedule →", games_path(season_scope_params), class: "text-sm text-accent hover:brightness-125 font-medium whitespace-nowrap" %>
        </div>
      </div>
    <% else %>
      <!-- Hero metric: net profit against break-even. Everything else is
           secondary, and sized accordingly. -->
      <div class="card">
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
          <div>
            <p class="section-label"><%= @is_recap ? "Final net profit" : "Net profit" %></p>
            <p class="text-4xl sm:text-5xl font-bold mt-1 figure <%= @metrics[:total_profit].positive? ? 'text-positive' : @metrics[:total_profit].negative? ? 'text-negative' : 'text-content' %>">
              <%= signed_currency(@metrics[:total_profit]) %>
            </p>
            <p class="text-sm text-content-dim mt-2">
              <span class="<%= @metrics[:roi] >= 0 ? 'text-positive' : 'text-negative' %> font-semibold figure">
                <%= @metrics[:roi] >= 0 ? '+' : '' %><%= @metrics[:roi] %>%
              </span>
              ROI on $<%= number_with_delimiter(@metrics[:total_cost].round) %> committed
              <% if !@is_recap && @metrics[:projected_roi] != @metrics[:roi] %>
                · projected
                <span class="<%= @metrics[:projected_roi] >= 0 ? 'text-positive' : 'text-negative' %> font-medium figure">
                  <%= @metrics[:projected_roi] >= 0 ? '+' : '' %><%= @metrics[:projected_roi] %>%
                </span>
              <% end %>
            </p>
          </div>

          <!-- Cost recovery: the one progress indicator that matters -->
          <div class="lg:w-80">
            <div class="flex justify-between items-baseline mb-2">
              <span class="section-label">Cost recovery</span>
              <span class="text-sm font-semibold figure <%= @metrics[:cost_recovery_rate] >= 100 ? 'text-positive' : 'text-warning' %>">
                <%= @metrics[:cost_recovery_rate] %>%
              </span>
            </div>
            <div class="w-full bg-canvas rounded-full h-2 border border-subtle">
              <div class="h-2 rounded-full transition-all duration-500 <%= @metrics[:cost_recovery_rate] >= 100 ? 'bg-positive' : 'bg-warning' %>"
                   style="width: <%= [[@metrics[:cost_recovery_rate], 100].min, 0].max %>%"></div>
            </div>
            <p class="text-xs text-muted mt-2">
              <span class="text-content figure">$<%= number_with_delimiter(@metrics[:total_revenue].round) %></span>
              of $<%= number_with_delimiter(@metrics[:total_cost].round) %> ·
              <% if @metrics[:cost_recovery_rate] >= 100 %>
                Season cost recovered
              <% else %>
                $<%= number_with_delimiter(@metrics[:revenue_to_break_even].round) %> to break even
              <% end %>
            </p>
          </div>
        </div>
      </div>

      <!-- Secondary metrics: label/value pairs, one size down. -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-subtle rounded-xl overflow-hidden border border-subtle">
        <div class="bg-surface p-4 sm:p-5">
          <p class="section-label">Gross margin</p>
          <p class="text-lg sm:text-xl font-semibold mt-1 figure <%= @metrics[:gross_margin] >= 0 ? 'text-content-strong' : 'text-negative' %>">
            <%= @metrics[:gross_margin] %>%
          </p>
          <p class="text-xs text-muted mt-1">Profit per dollar earned</p>
        </div>

        <div class="bg-surface p-4 sm:p-5">
          <p class="section-label">Sell-through</p>
          <p class="text-lg sm:text-xl font-semibold mt-1 text-content-strong figure">
            <%= @metrics[:sell_through_rate] %>%
          </p>
          <p class="text-xs text-muted mt-1"><%= @metrics[:tickets_sold] %> of <%= @metrics[:total_tickets] %> tickets</p>
        </div>

        <div class="bg-surface p-4 sm:p-5">
          <p class="section-label">Avg markup</p>
          <p class="text-lg sm:text-xl font-semibold mt-1 figure <%= @metrics[:average_markup] >= 0 ? 'text-content-strong' : 'text-negative' %>">
            <%= @metrics[:average_markup] >= 0 ? '+' : '' %><%= @metrics[:average_markup] %>%
          </p>
          <p class="text-xs text-muted mt-1">Above face value</p>
        </div>

        <div class="bg-surface p-4 sm:p-5">
          <p class="section-label">Avg sale price</p>
          <p class="text-lg sm:text-xl font-semibold mt-1 text-content-strong figure">
            $<%= number_with_delimiter(@metrics[:average_sale_price].round) %>
          </p>
          <p class="text-xs text-muted mt-1">vs $<%= number_with_delimiter(@metrics[:average_cost_per_ticket].round) %> cost</p>
        </div>
      </div>
    <% end %>
  </section>

  <!-- ============================== -->
  <!-- ZONE 2: FINANCIALS            -->
  <!-- ============================== -->
  <section class="space-y-4">
    <h2 class="section-label">Financials</h2>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-subtle rounded-xl overflow-hidden border border-subtle">
      <div class="bg-surface p-4 sm:p-5">
        <p class="section-label"><%= @is_recap ? "Unsold inventory" : "Remaining inventory" %></p>
        <p class="text-lg sm:text-xl font-semibold mt-1 text-content-strong figure"><%= @metrics[:remaining_tickets] %></p>
        <p class="text-xs text-muted mt-1">tickets</p>
      </div>
      <div class="bg-surface p-4 sm:p-5">
        <p class="section-label">Games with sales</p>
        <p class="text-lg sm:text-xl font-semibold mt-1 text-content-strong figure"><%= @metrics[:games_with_sales] %>/<%= @metrics[:total_games] %></p>
        <p class="text-xs text-muted mt-1">games</p>
      </div>
      <div class="bg-surface p-4 sm:p-5">
        <p class="section-label">Avg revenue/game</p>
        <p class="text-lg sm:text-xl font-semibold mt-1 text-content-strong figure">$<%= number_with_delimiter(@metrics[:average_revenue_per_game].round) %></p>
        <p class="text-xs text-muted mt-1">per game played or sold</p>
      </div>
      <div class="bg-surface p-4 sm:p-5">
        <p class="section-label">Tickets to break even</p>
        <% if !@is_recap && @metrics[:tickets_to_break_even].to_i > 0 %>
          <p class="text-lg sm:text-xl font-semibold mt-1 text-warning figure"><%= @metrics[:tickets_to_break_even] %></p>
          <p class="text-xs text-muted mt-1">at the average sale price</p>
        <% else %>
          <p class="text-lg sm:text-xl font-semibold mt-1 text-content-dim figure">—</p>
          <p class="text-xs text-muted mt-1"><%= @is_recap ? "season over" : "already covered" %></p>
        <% end %>
      </div>
    </div>

    <!-- Recap summary (completed seasons only) -->
    <% if @is_recap %>
      <%= render "recap_summary", season: @season %>
    <% end %>

    <!-- Profit by game type -->
    <%= render "game_type_breakdown", breakdown: @game_type_breakdown %>
  </section>

  <!-- ============================== -->
  <!-- ZONE 3: PERFORMANCE           -->
  <!-- ============================== -->
  <section class="space-y-4">
    <h2 class="section-label">Performance</h2>

    <!-- Revenue over time -->
    <%= render "revenue_chart", monthly_financials: @monthly_financials %>

    <!-- Profit by game -->
    <div class="card">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-bold text-content-strong">Profit by Game</h2>
        <span class="text-xs text-muted"><%= pluralize(@game_profits.count, "game") %></span>
      </div>
      <% if @game_profits.any? %>
        <div class="h-64 sm:h-80">
          <canvas id="profitChart"
                  data-dashboard-charts-target="profitChart"
                  data-game-profits='<%= @game_profits.to_json %>'></canvas>
        </div>
      <% else %>
        <p class="text-content-dim text-center py-8">No games yet</p>
      <% end %>
    </div>

    <!-- Best / worst performers -->
    <% if @best_game || @worst_game %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
        <% if @best_game %>
          <div class="card border-l-4 border-l-positive">
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-5 h-5 text-positive" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
              </svg>
              <h3 class="font-bold text-positive">Top Performer</h3>
            </div>
            <%= link_to @best_game, class: "block group" do %>
              <div class="flex justify-between items-center">
                <div>
                  <p class="font-semibold text-content-strong group-hover:text-accent transition-colors">vs <%= @best_game.opponent.name %></p>
                  <p class="text-sm text-content-dim"><%= @best_game.game_date.strftime("%B %d") %></p>
                </div>
                <div class="text-right">
                  <p class="text-lg font-bold figure <%= @best_game.profit_loss.positive? ? 'text-positive' : @best_game.profit_loss.negative? ? 'text-negative' : 'text-content' %>"><%= signed_currency(@best_game.profit_loss) %></p>
                  <p class="text-xs text-muted"><%= @best_game.tickets_sold_count %>/<%= @season.num_seats %> sold</p>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>

        <% if @worst_game %>
          <div class="card border-l-4 <%= @worst_game.profit_loss >= 0 ? 'border-l-warning' : 'border-l-negative' %>">
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-5 h-5 <%= @worst_game.profit_loss >= 0 ? 'text-warning' : 'text-negative' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6"></path>
              </svg>
              <h3 class="font-bold <%= @worst_game.profit_loss >= 0 ? 'text-warning' : 'text-negative' %>"><%= @is_recap ? 'Weakest Game' : 'Needs Attention' %></h3>
            </div>
            <%= link_to @worst_game, class: "block group" do %>
              <div class="flex justify-between items-center">
                <div>
                  <p class="font-semibold text-content-strong group-hover:text-accent transition-colors">vs <%= @worst_game.opponent.name %></p>
                  <p class="text-sm text-content-dim"><%= @worst_game.game_date.strftime("%B %d") %></p>
                </div>
                <div class="text-right">
                  <p class="text-lg font-bold <%= @worst_game.profit_loss >= 0 ? 'text-warning' : 'text-negative' %>">
                    <%= signed_currency(@worst_game.profit_loss) %>
                  </p>
                  <p class="text-xs text-muted"><%= @worst_game.tickets_sold_count %>/<%= @season.num_seats %> sold</p>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>

  <!-- ============================== -->
  <!-- ZONE 4: ACTIVITY & INVENTORY  -->
  <!-- ============================== -->
  <section class="space-y-4">
    <h2 class="section-label">Activity &amp; Inventory</h2>

    <div class="grid grid-cols-1 <%= "lg:grid-cols-2" if @is_recap %> gap-6">
      <!-- Final results (recap). The active season's next games are at the top. -->
      <% if @is_recap %>
      <div class="card">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-bold text-content-strong"><%= @is_recap ? 'Final Results' : 'Upcoming Games' %></h2>
          <%= link_to "View All", games_path, class: "text-sm text-accent hover:brightness-125" %>
        </div>
        <div class="space-y-3">
          <% list = @past_games %>
          <% if list.any? %>
            <% list.each do |game| %>
              <%= link_to game, class: "block bg-canvas rounded-lg p-4 border border-subtle hover:border-accent transition-colors" do %>
                <div class="flex justify-between items-center">
                  <div>
                    <p class="font-semibold text-content-strong">vs <%= game.opponent.name %></p>
                    <p class="text-sm text-content-dim"><%= game.game_date.strftime("%B %d, %Y") %></p>
                  </div>
                  <div class="text-right">
                    <% if @is_recap %>
                      <p class="text-sm font-bold <%= game.profit_loss >= 0 ? 'text-positive' : 'text-negative' %>">
                        <%= signed_currency(game.profit_loss) %>
                      </p>
                      <p class="text-xs text-muted"><%= game.tickets_sold_count %>/<%= @season.num_seats %> sold</p>
                    <% else %>
                      <% sold_pct = (game.tickets_sold_count.to_f / @season.num_seats * 100).round %>
                      <p class="text-sm font-medium <%= game.fully_sold? ? 'text-positive' : game.partially_sold? ? 'text-warning' : 'text-content-dim' %>">
                        <%= game.tickets_sold_count %>/<%= @season.num_seats %>
                      </p>
                      <div class="w-16 bg-surface-raised rounded-full h-1.5 mt-1">
                        <div class="h-1.5 rounded-full <%= game.fully_sold? ? 'bg-positive' : game.partially_sold? ? 'bg-warning' : 'bg-strong' %>" style="width: <%= sold_pct %>%"></div>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            <% end %>
          <% else %>
            <p class="text-content-dim text-center py-8"><%= @is_recap ? 'No games this season' : 'No upcoming games' %></p>
          <% end %>
        </div>
      </div>
      <% end %>

      <!-- Recent Sales -->
      <div class="card">
        <h2 class="text-lg font-bold text-content-strong mb-4">Recent Sales</h2>
        <div class="space-y-3">
          <% if @recent_sales.any? %>
            <% @recent_sales.each do |ticket| %>
              <div class="bg-canvas rounded-lg p-4 border border-subtle">
                <div class="flex justify-between items-center">
                  <div>
                    <p class="font-semibold text-content-strong">vs <%= ticket.game.opponent.name %></p>
                    <p class="text-sm text-content-dim">Seat <%= ticket.seat_number %> &bull; <%= ticket.sold_at.strftime("%b %d") %></p>
                  </div>
                  <div class="text-right">
                    <p class="text-lg font-bold text-positive">$<%= number_with_delimiter(ticket.sale_price.to_i) %></p>
                    <% markup = ((ticket.sale_price / ticket.game.cost_per_ticket - 1) * 100).round %>
                    <p class="text-xs <%= markup >= 0 ? 'text-positive' : 'text-negative' %>">
                      <%= markup >= 0 ? '+' : '' %><%= markup %>% markup
                    </p>
                  </div>
                </div>
              </div>
            <% end %>
          <% else %>
            <p class="text-content-dim text-center py-8">No sales yet</p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Game Status Summary -->
    <div class="card">
      <h2 class="text-lg font-bold text-content-strong mb-4">Inventory Status</h2>
      <div class="grid grid-cols-3 gap-4">
        <div class="bg-canvas rounded-lg p-4 border border-subtle text-center">
          <div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-positive/20 mb-2">
            <svg class="w-5 h-5 text-positive" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <p class="text-2xl sm:text-3xl font-bold text-positive"><%= @games_fully_sold %></p>
          <p class="text-xs text-content-dim mt-1">Fully Sold</p>
        </div>
        <div class="bg-canvas rounded-lg p-4 border border-subtle text-center">
          <div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-warning/20 mb-2">
            <svg class="w-5 h-5 text-warning" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <p class="text-2xl sm:text-3xl font-bold text-warning"><%= @games_partially_sold %></p>
          <p class="text-xs text-content-dim mt-1">Partially Sold</p>
        </div>
        <div class="bg-canvas rounded-lg p-4 border border-subtle text-center">
          <div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-negative/20 mb-2">
            <svg class="w-5 h-5 text-negative" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
          </div>
          <p class="text-2xl sm:text-3xl font-bold text-negative"><%= @games_unsold %></p>
          <p class="text-xs text-content-dim mt-1">No Sales</p>
        </div>
      </div>
    </div>
  </section>
</div>
