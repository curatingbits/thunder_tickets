<%# The next few games: when, how close, what's left to sell, and (with
    market data) what to list at. %>
<section class="space-y-3" data-dashboard-section="next-games">
  <div class="flex items-center justify-between">
    <h2 class="section-label">Next games</h2>
    <%= link_to "All upcoming →", games_path(filter: "upcoming"), class: "text-xs text-accent hover:brightness-125" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-3 sm:gap-4">
    <% rows.each do |row| %>
      <% game = row.game %>
      <%= link_to game_path(game), class: "card block hover:border-accent transition-colors" do %>
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="font-bold text-content-strong truncate">vs <%= game.opponent.name %></p>
            <p class="text-sm text-content-dim mt-0.5"><%= game_when(game) %></p>
          </div>
          <%= countdown_chip(game) %>
        </div>
        <div class="flex items-center justify-between gap-3 mt-4 pt-3 border-t border-subtle">
          <div class="flex flex-wrap gap-1.5">
            <%= inventory_chip(game) %>
            <%= listing_status_chip(row.status) if row.seats_to_sell.positive? %>
          </div>
          <% if row.seats_to_sell.positive? && row.snapshot&.recommended_list_price %>
            <span class="text-xs text-muted whitespace-nowrap">List at <span class="text-content-strong font-semibold figure"><%= dollars(row.snapshot.recommended_list_price) %></span></span>
          <% elsif (price = game.break_even_price_for_remaining) %>
            <span class="text-xs text-muted whitespace-nowrap">Break even <span class="text-content figure">$<%= number_with_delimiter(price.round) %></span>/seat</span>
          <% elsif game.fully_sold? %>
            <span class="text-xs text-muted whitespace-nowrap">Revenue <span class="text-content figure">$<%= number_with_delimiter(game.total_revenue.round) %></span></span>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</section>
