<%# The dashboard's to-do list, most urgent first (Attention::Feed). %>
<section class="space-y-3" data-dashboard-section="attention">
  <div class="flex items-center justify-between">
    <h2 class="section-label">Needs attention</h2>
    <%= link_to "Review listings →", listing_review_path, class: "text-xs text-accent hover:brightness-125" %>
  </div>

  <% if items.any? %>
    <ul class="card p-0 divide-y divide-subtle overflow-hidden">
      <% items.each do |item| %>
        <% game = item.game %>
        <li data-attention-kind="<%= item.kind %>" data-attention-priority="<%= item.priority %>">
          <%= link_to (item.kind == :verify_listing ? listing_review_path : game_path(game)),
                class: "flex items-center gap-3 px-4 sm:px-6 py-4 hover:bg-surface-raised transition-colors" do %>
            <%= icon(:exclamation, "h-5 w-5 shrink-0 #{item.priority <= 2 ? "text-warning" : "text-accent"}") %>
            <div class="flex-1 min-w-0">
              <p class="font-semibold text-content-strong">
                <% case item.kind %>
                <% when :transfer_pending %>
                  Deliver <%= pluralize(item.status.untransferred_count, "ticket") %> vs <%= game.opponent.name %>
                <% when :unsold_soon %>
                  <%= pluralize(item.seats_open, "seat") %> to sell vs <%= game.opponent.name %>
                <% when :not_listed %>
                  List <%= pluralize(item.seats_open, "seat") %> vs <%= game.opponent.name %>
                <% when :verify_listing %>
                  Confirm the listing vs <%= game.opponent.name %>
                <% end %>
              </p>
              <p class="text-sm text-content-dim">
                <%= game_when(game) %>
                <% case item.kind %>
                <% when :transfer_pending %>
                  · sold, not marked delivered
                <% when :unsold_soon %>
                  <% if (price = game.break_even_price_for_remaining) %>
                    · break even at <span class="text-content figure">$<%= number_with_delimiter(price.round) %></span> each
                  <% end %>
                <% else %>
                  · <%= listing_status_detail(item.status) %>
                <% end %>
              </p>
            </div>
            <div class="flex flex-col items-end gap-1 shrink-0">
              <%= countdown_chip(game) || status_chip("In #{item.days} days", tone: :neutral, icon_name: :clock) %>
              <%= listing_status_chip(item.status) unless item.kind == :transfer_pending %>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="card flex items-center gap-3 py-4">
      <%= icon(:check, "h-5 w-5 shrink-0 text-positive") %>
      <p class="text-sm text-content-dim">All clear: nothing to sell, deliver or confirm in the next <%= Attention::Feed::WINDOW_DAYS %> days.</p>
    </div>
  <% end %>
</section>
