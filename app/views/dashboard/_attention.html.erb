<%# The dashboard's to-do list, most urgent first (Attention::Feed). %>
<section class="space-y-3" data-dashboard-section="attention">
  <div class="flex items-center justify-between">
    <h2 class="section-label">Needs attention</h2>
    <%= link_to "Review listings →", listing_review_path, class: "text-xs text-accent hover:brightness-125" %>
  </div>

  <% if items.any? %>
    <ul class="card p-0 divide-y divide-subtle overflow-hidden">
      <% items.each do |item| %>
        <li data-attention-kind="<%= item.kind %>" data-attention-priority="<%= item.priority %>">
          <%= link_to attention_path(item), class: "flex items-center gap-3 px-4 sm:px-6 py-4 hover:bg-surface-raised transition-colors" do %>
            <%= icon(:exclamation, "h-5 w-5 shrink-0 #{item.priority <= 2 ? "text-warning" : "text-accent"}") %>
            <div class="flex-1 min-w-0">
              <p class="font-semibold text-content-strong"><%= attention_title(item) %></p>
              <p class="text-sm text-content-dim"><%= attention_detail(item) %></p>
            </div>
            <% if item.game %>
              <div class="flex flex-col items-end gap-1 shrink-0">
                <%= countdown_chip(item.game) || status_chip("In #{item.days} days", tone: :neutral, icon_name: :clock) %>
                <% if item.kind == :reprice %>
                  <%= assessment_chip(item.assessment) %>
                <% elsif item.kind != :transfer_pending %>
                  <%= listing_status_chip(item.status) %>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="card flex items-center gap-3 py-4">
      <%= icon(:check, "h-5 w-5 shrink-0 text-positive") %>
      <p class="text-sm text-content-dim">All clear: nothing to sell, deliver or confirm in the next <%= Attention::Feed::WINDOW_DAYS %> days.</p>
    </div>
  <% end %>
</section>
