# Optional mid-week rescan: the next seven days' games only, where prices
# move fastest. Same shape as the Monday unit.
[Unit]
Description=MADR Tickets - mid-week Ticketmaster rescan (next 7 days)
OnFailure=madr-automation-alert@%n.service

[Service]
Type=oneshot
EnvironmentFile=%h/.config/madrtickets/research.env
ExecStartPre=/usr/bin/systemd-run --user --quiet --collect /usr/bin/chromium --profile-directory=${MADR_RESEARCH_PROFILE}
ExecStartPre=/bin/sleep 10
ExecStart=/usr/bin/systemd-run --user --quiet --collect --working-directory=%h/Repositories/Agents/thunder_tickets /usr/bin/alacritty --title "MADR - Ticketmaster mid-week rescan" --working-directory %h/Repositories/Agents/thunder_tickets -e %h/.local/share/mise/shims/claude "/ticketmaster-pricing soon"
