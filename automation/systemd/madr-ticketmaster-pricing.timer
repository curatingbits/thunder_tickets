# Mondays and Wednesdays at 4am Central, a few minutes' jitter (Duggan,
# 2026-11-16). Each run has its own key (tm-<date>), so both happen.
[Unit]
Description=MADR Tickets - Ticketmaster pricing research (Mon and Wed)

[Timer]
OnCalendar=Mon,Wed *-*-* 04:00:00 America/Chicago
Persistent=true
RandomizedDelaySec=15m

[Install]
WantedBy=timers.target
