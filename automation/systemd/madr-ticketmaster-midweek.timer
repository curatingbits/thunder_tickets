# Proposed: Thursday 6:30am Central. Only worth enabling once the Monday run
# is reliable: systemctl --user enable --now madr-ticketmaster-midweek.timer
[Unit]
Description=MADR Tickets - mid-week Ticketmaster rescan

[Timer]
OnCalendar=Thu *-*-* 06:30:00 America/Chicago
Persistent=true
RandomizedDelaySec=15m

[Install]
WantedBy=timers.target
