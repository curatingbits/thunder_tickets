# Every day at 7:30am Central (Duggan, 2026-11-16). A day with nothing new
# replays as "already in"; Telegram only when a payment needs review.
[Unit]
Description=MADR Tickets - daily Venmo settlement sync

[Timer]
OnCalendar=*-*-* 07:30:00 America/Chicago
Persistent=true
RandomizedDelaySec=10m

[Install]
WantedBy=timers.target
