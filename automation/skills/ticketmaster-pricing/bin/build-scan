#!/usr/bin/env python3
"""Builds one game's market_scans body from the page reader's chunks.

  build-scan W GAME_ID EVENT_URL EVENT_DATE TOTAL_LISTINGS SCROLL_COMPLETE "TITLE"

Reads $W/rows-<GAME_ID>.txt (each line one window.__madrChunk(...) result:
a JSON array of [position, section, row, price, "R"|"S", label, seats]), the
reader's summary in $W/meta-<GAME_ID>.json (window.__madrMeta(), for the
second look at our seat count), and the run's $W/client_id, and writes
$W/scan-<GAME_ID>.json for
`bin/madr-api POST /api/v1/import_runs/<run id>/market_scans`. Listings are
copied as read; nothing is changed to make a post go through.
"""
import datetime
import json
import os
import re
import sys

work, game_id, event_url, event_date, total, scroll_complete, title = sys.argv[1:8]
rows = []
with open(f"{work}/rows-{game_id}.txt", encoding="utf-8") as f:
    for line in f:
        if line.strip():
            rows.extend(json.loads(line))

positions = [r[0] for r in rows]
assert len(positions) == len(set(positions)), "the same listing appears twice: re-read the chunks"
match = re.search(r"/event/([0-9A-Za-z]+)", event_url)
assert match, f"no event id in {event_url}"
assert re.fullmatch(r"\d{4}-\d{2}-\d{2}", event_date), f"event date {event_date} isn't YYYY-MM-DD"

def listing(row):
    position, section, seat_row, price, kind, label = row[:6]
    item = {"position": position, "section": section, "row": seat_row, "price": price,
            "ticket_type": "standard_admission" if kind == "S" else "verified_resale", "raw_label": label}
    seats = row[6] if len(row) > 6 else None
    if seats:  # read only in our row: the app counts a listing as ours by its seats
        item["seats"] = seats
    return item


listings = [listing(row) for row in rows]
scan = {"client_id": open(f"{work}/client_id").read().strip(), "game_id": int(game_id), "event_id": match.group(1),
        "event_url": event_url.split("?")[0], "event_title": title, "event_date": event_date,
        "event_total_listings": int(total), "scroll_complete": scroll_complete == "true",
        "captured_at": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
        "quantity_filter": 2, "listings": listings}
meta_path = f"{work}/meta-{game_id}.json"
if os.path.exists(meta_path):
    with open(meta_path, encoding="utf-8") as f:
        check = json.load(f).get("quantity_check")
    if check:  # our row read again at our seat count (3-together listings hide at 2)
        scan["quantity_check"] = check
with open(f"{work}/scan-{game_id}.json", "w", encoding="utf-8") as f:
    json.dump(scan, f, ensure_ascii=False)
extra = f", second look at {scan['quantity_check']['quantity']}: {len(scan['quantity_check'].get('listings') or [])} in our row" if "quantity_check" in scan else ""
print(f"game {game_id}: {len(listings)} listings{extra} -> {work}/scan-{game_id}.json")
